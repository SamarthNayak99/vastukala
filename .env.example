# Leave DATABASE_URL unset to use the project-local PostgreSQL runtime with npm run dev.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/vastukala
PORT=3001
APP_ORIGIN=http://localhost:5173
# Set a long random secret for a separately hosted API. Local dev generates one in .local/.
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional architecture guide. Keep the key on the server; never use VITE_ for it.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
