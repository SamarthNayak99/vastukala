{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "client/dist",
  "regions": ["sin1"],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index?__vastukala_route=$1" },
    { "handle": "filesystem" },
    { "src": "/(?:assets|media)/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
