digraph ER {graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.45,ranksep=1.1,splines=polyline,outputorder=edgesfirst];node [shape=plain,fontname="Helvetica"];edge [fontname="Helvetica",fontsize=12,fontcolor="#625747",arrowsize=.8,labeldistance=2];"states" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>states</B></FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     name : text</FONT></TD></TR><TR><TD PORT="kind" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       kind : text</FONT></TD></TR></TABLE>>];
"sites" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>sites</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     name : text</FONT></TD></TR><TR><TD PORT="slug" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     slug : text</FONT></TD></TR><TR><TD PORT="locality" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       locality : text</FONT></TD></TR><TR><TD PORT="district" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       district : text</FONT></TD></TR><TR><TD PORT="state" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     state : text</FONT></TD></TR><TR><TD PORT="overview" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       overview : text</FONT></TD></TR><TR><TD PORT="map_latitude" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       map_latitude : numeric ?</FONT></TD></TR><TR><TD PORT="map_longitude" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       map_longitude : numeric ?</FONT></TD></TR><TR><TD PORT="map_source_url" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       map_source_url : text ?</FONT></TD></TR></TABLE>>];
"buildings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>buildings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="site_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     site_id : int</FONT></TD></TR><TR><TD PORT="type_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     type_id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text</FONT></TD></TR><TR><TD PORT="slug" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     slug : text</FONT></TD></TR><TR><TD PORT="summary" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       summary : text</FONT></TD></TR><TR><TD PORT="history" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       history : text</FONT></TD></TR><TR><TD PORT="layout_notes" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       layout_notes : text</FONT></TD></TR><TR><TD PORT="year_from" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_from : int ?</FONT></TD></TR><TR><TD PORT="year_to" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_to : int ?</FONT></TD></TR><TR><TD PORT="date_label" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       date_label : text</FONT></TD></TR><TR><TD PORT="date_precision" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       date_precision : text</FONT></TD></TR><TR><TD PORT="latitude" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       latitude : numeric ?</FONT></TD></TR><TR><TD PORT="longitude" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       longitude : numeric ?</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       status : text</FONT></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       created_at : timestamptz</FONT></TD></TR><TR><TD PORT="updated_at" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       updated_at : timestamptz</FONT></TD></TR></TABLE>>];
"building_types" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>building_types</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     name : text</FONT></TD></TR><TR><TD PORT="description" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       description : text</FONT></TD></TR></TABLE>>];
"building_aliases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>building_aliases</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="building_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     building_id : int</FONT></TD></TR><TR><TD PORT="alias" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       alias : text</FONT></TD></TR></TABLE>>];
"buildings":id -> "building_aliases":building_id [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R01",style=solid,color="#547265"];
"sites":id -> "buildings":site_id [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R10",style=solid,color="#547265"];
"building_types":id -> "buildings":type_id [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R11",style=solid,color="#547265"];
"states":name -> "sites":state [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R22",style=solid,color="#547265"];
}