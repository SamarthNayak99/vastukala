digraph ER {graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.45,ranksep=1.1,splines=polyline,outputorder=edgesfirst];node [shape=plain,fontname="Helvetica"];edge [fontname="Helvetica",fontsize=12,fontcolor="#625747",arrowsize=.8,labeldistance=2];"admins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#625747"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>admins</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     email : text</FONT></TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       password_hash : text</FONT></TD></TR></TABLE>>];
"sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#625747"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>sessions</B></FONT></TD></TR><TR><TD PORT="sid" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     sid : varchar</FONT></TD></TR><TR><TD PORT="sess" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       sess : json</FONT></TD></TR><TR><TD PORT="expire" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       expire : timestamp</FONT></TD></TR></TABLE>>];
"schema_migrations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#625747"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>schema_migrations</B></FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     name : text</FONT></TD></TR><TR><TD PORT="applied_at" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       applied_at : timestamptz</FONT></TD></TR></TABLE>>];
"seed_tasks" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#625747"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>seed_tasks</B></FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     name : text</FONT></TD></TR><TR><TD PORT="applied_at" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       applied_at : timestamptz</FONT></TD></TR></TABLE>>];

{rank=same; "admins"; "sessions";} {rank=same; "schema_migrations"; "seed_tasks";} "admins" -> "schema_migrations" [style=invis]; "sessions" -> "seed_tasks" [style=invis];}