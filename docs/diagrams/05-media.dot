digraph ER {graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.45,ranksep=1.1,splines=polyline,outputorder=edgesfirst];node [shape=plain,fontname="Helvetica"];edge [fontname="Helvetica",fontsize=12,fontcolor="#625747",arrowsize=.8,labeldistance=2];"buildings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>buildings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text</FONT></TD></TR></TABLE>>];
"images" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>images</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="building_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     building_id : int</FONT></TD></TR><TR><TD PORT="building_element_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     building_element_id : int ?</FONT></TD></TR><TR><TD PORT="storage_key" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       storage_key : text</FONT></TD></TR><TR><TD PORT="source_page_url" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       source_page_url : text</FONT></TD></TR><TR><TD PORT="original_url" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       original_url : text</FONT></TD></TR><TR><TD PORT="author" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       author : text</FONT></TD></TR><TR><TD PORT="licence_code" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       licence_code : text</FONT></TD></TR><TR><TD PORT="licence_url" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       licence_url : text</FONT></TD></TR><TR><TD PORT="caption" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       caption : text</FONT></TD></TR><TR><TD PORT="alt_text" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       alt_text : text</FONT></TD></TR><TR><TD PORT="width" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       width : int</FONT></TD></TR><TR><TD PORT="height" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       height : int</FONT></TD></TR><TR><TD PORT="byte_size" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       byte_size : bigint</FONT></TD></TR><TR><TD PORT="modification_note" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       modification_note : text</FONT></TD></TR><TR><TD PORT="sort_order" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       sort_order : int</FONT></TD></TR><TR><TD PORT="is_cover" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       is_cover : bool</FONT></TD></TR><TR><TD PORT="approved" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       approved : bool</FONT></TD></TR></TABLE>>];
