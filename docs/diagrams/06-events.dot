digraph ER {graph [rankdir=LR,bgcolor="transparent",pad=.25,nodesep=.45,ranksep=1.1,splines=polyline,outputorder=edgesfirst];node [shape=plain,fontname="Helvetica"];edge [fontname="Helvetica",fontsize=12,fontcolor="#625747",arrowsize=.8,labeldistance=2];"buildings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>buildings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text</FONT></TD></TR><TR><TD PORT="year_from" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_from : int ?</FONT></TD></TR><TR><TD PORT="year_to" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_to : int ?</FONT></TD></TR><TR><TD PORT="date_precision" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       date_precision : text</FONT></TD></TR></TABLE>>];
"sources" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>sources</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       title : text</FONT></TD></TR><TR><TD PORT="author_or_publisher" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       author_or_publisher : text</FONT></TD></TR><TR><TD PORT="url" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">UQ     url : text</FONT></TD></TR><TR><TD PORT="publication_year" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       publication_year : int ?</FONT></TD></TR><TR><TD PORT="accessed_on" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       accessed_on : date</FONT></TD></TR></TABLE>>];
"building_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#234537"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>building_events</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="building_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     building_id : int</FONT></TD></TR><TR><TD PORT="kind" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       kind : text</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       title : text</FONT></TD></TR><TR><TD PORT="description" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       description : text</FONT></TD></TR><TR><TD PORT="year_from" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_from : int</FONT></TD></TR><TR><TD PORT="year_to" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_to : int</FONT></TD></TR><TR><TD PORT="precision" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       precision : text</FONT></TD></TR><TR><TD PORT="source_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     source_id : int</FONT></TD></TR><TR><TD PORT="locator" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       locator : text</FONT></TD></TR></TABLE>>];
"buildings":id -> "building_events":building_id [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R04",style=solid,color="#547265"];
"sources":id -> "building_events":source_id [dir=both,arrowtail=teetee,arrowhead=ocrow,taillabel="1",headlabel="0..*",label="R05",style=solid,color="#547265"];
