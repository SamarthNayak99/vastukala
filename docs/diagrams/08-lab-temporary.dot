digraph Practice {graph [rankdir=LR,bgcolor="transparent",nodesep=.7,ranksep=1.3,pad=.25];node [shape=plain];edge [fontname="Helvetica",fontsize=13,color="#984930",fontcolor="#984930",arrowsize=.8];"lab_sites" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#984930"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>lab_sites</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text</FONT></TD></TR></TABLE>>];
"lab_buildings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#984930"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>lab_buildings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#984930">PK     id : int</FONT></TD></TR><TR><TD PORT="site_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     site_id : int ?</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text</FONT></TD></TR><TR><TD PORT="year_from" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_from : int ?</FONT></TD></TR><TR><TD PORT="year_to" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       year_to : int ?</FONT></TD></TR></TABLE>>];
"lab_links" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#984930"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>lab_links</B></FONT></TD></TR><TR><TD PORT="building_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">FK     building_id : int ?</FONT></TD></TR><TR><TD PORT="material" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       material : text</FONT></TD></TR></TABLE>>];
"lab_scale" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#c6bca9" BGCOLOR="#fffcf6"><TR><TD ALIGN="LEFT" BGCOLOR="#984930"><FONT FACE="Helvetica" COLOR="#fffaf0" POINT-SIZE="17"><B>lab_scale</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       id : int ?</FONT></TD></TR><TR><TD PORT="site_id" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       site_id : int ?</FONT></TD></TR><TR><TD PORT="name" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="13" COLOR="#302c25">       name : text ?</FONT></TD></TR></TABLE>>];
lab_sites:id -> lab_buildings:site_id [dir=both,arrowtail=odottee,arrowhead=ocrow,label="site_id FK",taillabel="0..1",headlabel="0..*"];lab_buildings:id -> lab_links:building_id [dir=both,arrowtail=odottee,arrowhead=ocrow,label="building_id FK",taillabel="0..1",headlabel="0..*"];{rank=same;lab_sites;lab_scale;}}